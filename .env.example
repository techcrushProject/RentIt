# RentIt environment template.
#   cp .env.example .env     then replace every CHANGE_ME value.
# .env is git-ignored; never commit real secrets. config/env.js validates all of
# this at startup and refuses to boot with a clear message if something is wrong.

# Generate a strong random value (use it for JWT_SECRET, SETUP_ADMIN_TOKEN and the passwords below):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---------------------------------------------------------------- Application
# development | production | test
NODE_ENV=development
PORT=3000

# Comma-separated frontend origins allowed by CORS (exact match, no trailing
# slash, never *). Required in production; in development it defaults to
# localhost / 127.0.0.1 on ports 3000, 5500, 5501 and 8080.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Number of reverse-proxy hops in front of the API (0 = none). Needed so rate
# limits see the real client IP. Defaults to 1 in production and 0 elsewhere.
TRUST_PROXY=0

# ------------------------------------------------------------------- Database
# Must match the app user created by docker-compose (MONGO_APP_USER /
# MONGO_APP_PASSWORD / MONGO_DB below). Special characters in the password must
# be URL-encoded (@ -> %40, : -> %3A, / -> %2F, % -> %25); a hex password avoids that.
MONGO_URI=mongodb://rentit_app:CHANGE_ME@127.0.0.1:27017/rentit?authSource=rentit

# Optional: a DISPOSABLE database used only by `npm run test:integration`.
# Its contents are dropped by the tests, so never point it at real data.
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/rentit_test

# --------------------------------------------------------------- Authentication
# At least 32 characters.
JWT_SECRET=CHANGE_ME
# Token lifetime: a number plus s, m, h or d (15m, 12h, 1d).
JWT_EXPIRES_IN=1d

# Secret for the one-time first-admin endpoint (sent in the X-Setup-Token
# header). At least 24 characters. Optional: replace it, or delete the line if
# you do not need it (and remove it again once the first admin exists).
SETUP_ADMIN_TOKEN=CHANGE_ME

# ----------------------------------------------------------------- Cloudinary
# Optional image hosting. Set all three or none.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------- docker-compose (MongoDB only)
# Read by docker-compose.yml, not by the API. The init script creates the app
# user once, when the data volume is empty.
MONGO_ROOT_USER=root_admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USER=rentit_app
MONGO_APP_PASSWORD=CHANGE_ME
MONGO_DB=rentit
# Host port on 127.0.0.1 that maps to MongoDB's 27017.
MONGO_PORT=27017
